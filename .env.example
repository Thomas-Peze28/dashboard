DATABASE_URL=postgresql://user:password@localhost/db_name
# Clé de signature des sessions (32 caractères minimum). Générez-la avec : openssl rand -hex 32
# Si elle est vide, le backend utilise une clé aléatoire et les sessions sont perdues à chaque redémarrage.
JWT_SECRET=

FRONTEND_URL="http://my-frontend-url.com"

GOOGLE_CLIENT_ID="my-google-client-id"
GOOGLE_CLIENT_SECRET="my-google-client-secret"
GOOGLE_REDIRECT_URI="http://my-backend-url.com/api/auth/google/callback"

GITHUB_CLIENT_ID="my-github-client-id"
GITHUB_CLIENT_SECRET="my-github-client-secret"
GITHUB_REDIRECT_URI="http://my-backend-url.com/api/auth/github/callback"

# Host port for the Mailpit web UI (change if 8025 is already taken)
MAILPIT_UI_PORT=8025
